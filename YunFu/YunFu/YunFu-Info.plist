<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- 基础信息 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en_US</string>

    <key>CFBundleDisplayName</key>
    <string>bieji</string>

    <key>CFBundleExecutable</key>
    <string>${EXECUTABLE_NAME}</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>${PRODUCT_NAME}</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- URL Scheme（Google 登录） -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.205971285604-7p5872iacnfm1ic4v4328a6jv52g1o3k</string>
            </array>
        </dict>
    </array>

    <key>GIDClientID</key>
    <string>205971285604-7p5872iacnfm1ic4v4328a6jv52g1o3k.apps.googleusercontent.com</string>

    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- 网络 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- 后台模式 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- UI -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIRequiresFullScreen</key>
    <true/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- ============================= -->
    <!-- ✅ 隐私权限（关键，修复崩溃） -->
    <!-- ============================= -->

    <!-- 📍 定位（天气 / 场景识别） -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于获取位置信息，以提供天气和场景相关的功能。</string>

    <!-- 🏃 运动与健身（行走 / 静止 / 驾驶状态） -->
    <key>NSMotionUsageDescription</key>
    <string>用于识别用户当前的运动状态（行走、运动或静止），以优化使用体验。</string>

    <!-- ❤️ 健康数据（心率，只读） -->
    <key>NSHealthShareUsageDescription</key>
    <string>用于读取心率等健康数据，以提供健康相关功能。</string>

    <!-- （可选）健康数据写入：当前不用可留着 -->
    <!--
    <key>NSHealthUpdateUsageDescription</key>
    <string>用于记录和更新健康相关数据。</string>
    -->

</dict>
</plist>
